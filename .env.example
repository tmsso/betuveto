# Betűvető environment variables.
# Copy to `.env` (or set in your deployment) and adjust as needed.

# --- Backend (FastAPI) ---
# Comma-separated list of allowed browser origins. Credentials are sent, so a
# wildcard is NOT valid here.
CORS_ORIGINS=http://localhost:5173

# Absolute path to the Hungarian word list. Defaults to the repo-root
# `data/magyar-szavak.txt`; the Docker/HF deployment sets this explicitly.
# WORDLIST_PATH=/app/data/magyar-szavak.txt

# --- Frontend (Vite) ---
# Base URL the frontend uses to reach the API. Defaults to `/api` (same-origin,
# proxied in dev). Override only for split deployments.
# VITE_API_BASE_URL=/api

# --- Database / Supabase (Batch 1) ---
# Connection string for the Supabase Postgres, used by `npm run db:import` (the
# wordlist importer) and, later, by SQL migrations. Point this at the CLOUD project
# (Supabase dashboard → Project Settings → Database → Connection string). Do NOT run
# a local Supabase stack for this — apply/validate against the hosted project.
# DATABASE_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres

# Server-only Supabase keys for the API routes (Batch 1.2). The service-role key
# bypasses Row Level Security and must NEVER be exposed to the browser (no VITE_ prefix).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=...
