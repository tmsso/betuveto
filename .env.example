# Betűvető environment variables.
# Copy to `.env` (or set in your deployment) and adjust as needed.

# --- Backend (FastAPI) ---
# Comma-separated list of allowed browser origins. Credentials are sent, so a
# wildcard is NOT valid here.
CORS_ORIGINS=http://localhost:5173

# Absolute path to the Hungarian word list. Defaults to the repo-root
# `data/magyar-szavak.txt`; the Docker/HF deployment sets this explicitly.
# WORDLIST_PATH=/app/data/magyar-szavak.txt

# --- Frontend (Vite) ---
# Base URL the frontend uses to reach the API. Defaults to `/api` (same-origin,
# proxied in dev). Override only for split deployments.
# VITE_API_BASE_URL=/api

# --- Database / Neon (Batch 1) ---
# Neon Postgres connection string, used by `npm run db:migrate`, `npm run db:import`,
# `npm run db:verify`, and the API functions. Use Neon's *pooled* connection string
# (Neon dashboard → Connection Details → Pooled connection) so serverless/one-shot
# connections go through the pooler. Server-only — never expose it with a VITE_ prefix.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# On Vercel the Neon integration injects POSTGRES_URL (the pooled connection); the API
# reads POSTGRES_URL and falls back to DATABASE_URL when run locally. Do not set by hand
# when the integration is configured.
# POSTGRES_URL=...

# --- Testing the deployed API (Batch 1.2) ---
# The HTTP contract suite runs against a deployment rather than a local server:
#   API_BASE_URL=https://<preview>.vercel.app npm test
# If Vercel deployment protection is enabled, also pass the automation bypass secret
# (Vercel → Settings → Deployment Protection → Protection Bypass for Automation).
# API_BASE_URL=https://<preview>.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET=...
